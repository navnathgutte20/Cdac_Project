	@Override
	public List<ProductResponse> getProductsForDealer(Long dealerId) {
		return productRepository.findByDealer_UserId(dealerId).stream().map(this::toResponse).toList();
	}

	private Product findProduct(Long productId) {
		Optional<Product> product = productRepository.findById(productId);
		if(product.isEmpty()) {
			new ResourceNotFoundException("Product not found with id: " + productId);
		}
		return product.get();
	}

	private User findDealer(Long dealerId) {
		User dealer = userRepository.findById(dealerId)
				.orElseThrow(() -> new ResourceNotFoundException("Dealer not found with id: " + dealerId));
		if (dealer.getRole() != com.farmafriend.erp.constants.RoleName.DEALER) {
			throw new BadRequestException("The specified user is not a dealer");
		}
		return dealer;
	}

	private ProductResponse toResponse(Product product) {
		return ProductResponse.builder().productId(product.getProductId()).productName(product.getProductName())
				.category(product.getCategory()).price(product.getPrice()).description(product.getDescription())
				.account(product.getAccount()).imageUrl(product.getImageUrl()).active(product.isActive())
				.dealerId(product.getDealer() != null ? product.getDealer().getUserId() : null)
				.dealerName(product.getDealer() != null ? product.getDealer().getName() : null)
				.stockQuantity(product.getStockQuantity()).availableStock(product.getAvailableStock())
				.reservedStock(product.getReservedStock()).build();
	}

	@Override
    @Transactional
    public ProductResponse updateStock(StockUpdateRequest request) {
        Product product = findProduct(request.getProductId());
        User dealer = findDealer(request.getDealerId());
        product.setDealer(dealer);

        int delta = request.getStockQuantity() - (product.getStockQuantity() == null ? 0 : product.getStockQuantity());
        product.setStockQuantity(request.getStockQuantity());
        int currentAvailable = product.getAvailableStock() == null ? 0 : product.getAvailableStock();
        product.setAvailableStock(Math.max(0, currentAvailable + delta));

        product = productRepository.save(product);
        return toResponse(product);
    }


	
}
