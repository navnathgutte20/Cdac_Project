package com.farmafriend.erp.controller;
package com.farmafriend.erp.controller;

import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.farmafriend.erp.service.CartService;

import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.RequiredArgsConstructor;

@RestController
@RequestMapping("/api/cart")
@RequiredArgsConstructor
@PreAuthorize("hasRole('CUSTOMER')")
@Tag(name = "Cart", description = "Customer shopping cart operations")
public class CartController {

    private final CartService cartService;
    private final CustomerRepository customerRepository;

    @GetMapping
    public ResponseEntity<ApiResponse<CartResponse>> getCart() {
        return ResponseEntity.ok(ApiResponse.success(cartService.getCart(currentCustomerId())));
    }

    @PostMapping("/add")
    public ResponseEntity<ApiResponse<CartResponse>> addItem(@Valid @RequestBody CartItemRequest request) {
        return ResponseEntity.ok(ApiResponse.success("Item added to cart", cartService.addItem(currentCustomerId(), request)));
    }

    @PutMapping("/item/{cartItemId}")
    public ResponseEntity<ApiResponse<CartResponse>> updateItem(@PathVariable Long cartItemId, @RequestParam int quantity) {
        return ResponseEntity.ok(ApiResponse.success("Cart item updated", cartService.updateItemQuantity(currentCustomerId(), cartItemId, quantity)));
    }

    @DeleteMapping("/item/{cartItemId}")
    public ResponseEntity<ApiResponse<CartResponse>> removeItem(@PathVariable Long cartItemId) {
        return ResponseEntity.ok(ApiResponse.success("Cart item removed", cartService.removeItem(currentCustomerId(), cartItemId)));
    }

    @DeleteMapping("/clear")
    public ResponseEntity<ApiResponse<Void>> clearCart() {
        cartService.clearCart(currentCustomerId());
        return ResponseEntity.ok(ApiResponse.success("Cart cleared", null));
    }

    private Long currentCustomerId() {
        Customer customer = customerRepository.findByUser_UserId(SecurityUtils.getCurrentUserId())
                .orElseThrow(() -> new ResourceNotFoundException("Customer profile not found for this account"));
        return customer.getCustomerId();
    }
}